* {
    background:                  {{colors.surface.default.hex}}b3;
    background-alt:              {{colors.surface_container.default.hex}}80;
    foreground:                  {{colors.on_surface.default.hex}};
    foreground-muted:            {{colors.on_surface_variant.default.hex}};
    
    active-background:           {{colors.secondary_container.default.hex}}cc;
    active-foreground:           {{colors.on_secondary_container.default.hex}};
    urgent-background:           {{colors.error.default.hex}};
    urgent-foreground:           {{colors.on_error.default.hex}};
    accent:                      {{colors.primary.default.hex}};
    arch-color:                  {{colors.primary.default.hex}}; 

    selected-background:         @accent;
    selected-foreground:         {{colors.on_primary.default.hex}};
    selected-urgent-background:  @urgent-background;
    selected-urgent-foreground:  @urgent-foreground;
    selected-active-background:  @active-background;
    selected-active-foreground:  @active-foreground;
    separatorcolor:              {{colors.outline_variant.default.hex}}66;
    bordercolor:                 {{colors.outline_variant.default.hex}}aa;
}